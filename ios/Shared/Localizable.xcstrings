{
  "sourceLanguage": "en",
  "strings": {
    "%lld done": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 完成"
          }
        }
      }
    },
    "%lld waiting": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 等你"
          }
        }
      }
    },
    "%lld working": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 工作中"
          }
        }
      }
    },
    "Can't connect: %@. The phone has to be on the tailnet of Gaddi's machine.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上：%@。手機要在 Gaddi 那台機器的 tailnet 上。"
          }
        }
      }
    },
    "Can't reach Gaddi": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不到 Gaddi"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Change URL": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改網址"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Clear the app's web data?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 app 裡的網頁資料？"
          }
        }
      }
    },
    "Connect and save": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線並儲存"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中…"
          }
        }
      }
    },
    "Download failed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載失敗"
          }
        }
      }
    },
    "Enter the URL `collie start` printed. It connects once before saving to make sure it's Gaddi. A different Gaddi needs pairing again over there.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 `collie start` 印出的網址。儲存前會先連一次，確認是 Gaddi。換成另一台 Gaddi 要在那邊重新配對。"
          }
        }
      }
    },
    "Expired": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已到期"
          }
        }
      }
    },
    "Finish saving the current file first.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成目前的檔案儲存。"
          }
        }
      }
    },
    "Gaddi Island": {
      "shouldTranslate": false
    },
