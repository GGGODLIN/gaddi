      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaddi 位址"
          }
        }
      }
    },
    "Gaddi app stopped updating": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaddi app 已停止更新"
          }
        }
      }
    },
    "Gaddi isn't paired": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaddi 尚未配對"
          }
        }
      }
    },
    "Gaddi's pairing expired": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaddi 配對已到期"
          }
        }
      }
    },
    "Gaddi's pairing was revoked": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaddi 配對已失效"
          }
        }
      }
    },
    "It answered, but it isn't Gaddi.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有回應，但不是 Gaddi。"
          }
        }
      }
    },
    "It answered, but sent no Gaddi data (HTTP %lld).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有回應，但沒有拿到 Gaddi 的資料（HTTP %lld）。"
          }
        }
      }
    },
