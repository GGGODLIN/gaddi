    },
    "Tap to pair again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對已被撤銷，點一下重新配對"
          }
        }
      }
    },
    "Tap to pair again (collie pair)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下重新配對（collie pair）"
          }
        }
      }
    },
    "That isn't a URL. It looks like https://your-mac.your-tailnet.ts.net:8443": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是網址。格式像 https://your-mac.your-tailnet.ts.net:8443"
          }
        }
      }
    },
    "The file name isn't valid.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案名稱無效。"
          }
        }
      }
    },
    "This link is for testing the backup. Unsent drafts are deleted; settings and pairing come back from the Keychain.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是測試備份用的連結。未送出的草稿會被刪掉，設定和配對會從 Keychain 還原。"
          }
        }
      }
    },
    "Unpaired": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未配對"
          }
        }
      }
    },
